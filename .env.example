# Copy to .env and fill in from Supabase Dashboard > Project Settings > API.
# Without these the site runs in DEMO MODE (data stored only in this browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# NEVER put the service-role key or payment gateway secrets here.
# Those belong in Supabase Edge Function secrets (see README).
